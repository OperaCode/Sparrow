# Copy to .env and fill in the blanks. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection URL.
DATABASE_URL=postgresql://sparrow:sparrow@localhost:5433/sparrow

# HS256 signing secret for access tokens, at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=sparrow-api
JWT_AUDIENCE=sparrow-app

# Comma-separated list of browser origins allowed by CORS (Expo web dev server).
# Native mobile clients do not need an entry.
CORS_ORIGINS=http://localhost:8081

# Number of reverse-proxy hops in front of the API. 0 locally, 1 on Render.
# Too low makes every client share the proxy IP for rate limiting; too high
# lets clients spoof X-Forwarded-For.
TRUST_PROXY=0

# Default rate limit applied to /api routes, per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
